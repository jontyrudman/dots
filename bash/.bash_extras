#
# Source this in a .bashrc after moving it and .bash_prompt to $HOME.
#

source $HOME/.bash_prompt
export PATH="$HOME/.node_modules/bin:$HOME/.local/bin:$PATH"
export EDITOR=nvim
export PATH=$HOME/go/bin:$PATH:/usr/local/go/bin

[ -f ~/.fzf.bash ] && source ~/.fzf.bash
export FZF_DEFAULT_OPTS="--history=$HOME/.fzf_history"

eval "$(~/.local/bin/mise activate bash)"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# pnpm
export PNPM_HOME="/home/jonathan/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
